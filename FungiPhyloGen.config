/*
 * -------------------------------------------------
 * FungiPhyloGen Nextflow Config (Optimized)
 * -------------------------------------------------
 */


params {
    // =================================================================
    // Input/Output Defaults
    // =================================================================

    inputDir    = "${launchDir}"
    resultsDir  = "${launchDir}/results"
    samplesheet = "${params.inputDir}/samplesheet.csv"

    // Reference Files
    refseq      = "${params.inputDir}/ref/Clade_I_B8441.fna"
    gbk         = "${params.inputDir}/ref/Clade_I_B8441.gbff"

    // =================================================================
    // Analysis Logic & Filters
    // =================================================================

    ploidy      = 1
    prjName     = "PRJ01"
    
    // This allows you to run: nextflow run main.nf --filter_profile wanomalus_batch
    filter_profile = "general" 
// Haploid population-SNP filter profiles.
//
// These filters operate on the normalized multi-sample BCF.
// QUAL/INFO/DP is intentionally excluded because merged QUAL is not
// recomputed across samples, whereas INFO/DP increases with cohort depth.
//
// F_MISSING is temporarily excluded from population profiles because
// bcftools merge -0 converts absent records to reference genotypes,
// preventing reliable missingness estimation.

    // =================================================================
    // Haploid population-SNP filter profiles
    // =================================================================
    //
    // AC, AN and AF are materialized after normalization using
    // bcftools +fill-tags.
    //
    // QUAL/INFO/DP is intentionally excluded. QUAL is inherited from
    // independently called sample records during merging, whereas INFO/DP
    // increases with cohort depth. The resulting ratio is therefore not
    // equivalent to GATK QD and is not stable across cohort sizes.
    //
    // F_MISSING is currently excluded because bcftools merge -0 converts
    // absent sample records to reference genotypes. Missingness filtering
    // will be reconsidered after missing genotypes are preserved correctly.
    //
    // Population AF thresholds are intentional. These profiles construct
    // conservative, population-representative haploid SNP sets.

    filters = [
        // Default population-level haploid SNP profile.
        'general'         : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.25',

        // Canonical C. auris population-SNP profile.
        'cauris'          : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.25',

        // Backward-compatible aliases retained for existing commands.
        // Cohort size no longer changes C. auris filtering behaviour.
        'cauris_small'    : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.25',
        'cauris_batch'    : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.25',

        // W. anomalus population-SNP profiles retain their established
        // species-specific population AF thresholds.
        'wanomalus_small' : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.75',
        'wanomalus_batch' : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.85',

        // Retained unchanged pending separate C. parapsilosis validation.
        'cparapsilosis'   : 'TYPE!="snp" || MQ<40 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || (QUAL/MAX(AD[:1]))<=2.0 || DP<10',

        // Explicit organism alias for the default AF >= 0.25 profile.
        'cneoformans'     : 'TYPE!="snp" || MQ<40 || QUAL<30 || FS>60 || (MQSBZ < -2.0 || MQSBZ > 2.0) || INFO/AF<0.25'
    ]

    active_filter = params.filters[params.filter_profile]

    // Toggles
    skip_trimming = false
    
    // Sub-directories
    trm         = "${params.resultsDir}/trimmed"
    bcftl       = "${params.resultsDir}/variants"
    ann         = "${params.resultsDir}/snpeff_annotation"
    iq          = "${params.resultsDir}/iqtree_phylogeny"
    dist        = "${params.resultsDir}/snp_distances"
    nj          = "${params.resultsDir}/rapidnj_tree"

    // =================================================================
    // Environment & Tool Paths
    // =================================================================
    condaCacheDir = "${HOME}/anaconda3/envs"
    

    // 1. Picard Path
    PICARD = "${params.condaCacheDir}/fpgAlign/share/picard-2.27.4-0/picard.jar"

    // 2. FastQC Configuration Paths
    FASTQC_CONF = "${params.condaCacheDir}/fpgtrimReads/opt/fastqc-0.11.9/Configuration"
    FASTQC_CONTAMINANTS = "${params.FASTQC_CONF}/contaminant_list.txt"
    FASTQC_ADAPTERS     = "${params.FASTQC_CONF}/adapter_list.txt"


    // Default Resource Limits
    max_memory = '12.GB'
    max_cpus   = 4
    max_time   = '240.h'
}


// =================================================================
// Profiles
// =================================================================
profiles {
    
    // Local / Laptop Profile
    standard {
        process.executor = 'local'
        conda.enabled    = true
        params.cacheDir   = params.condaCacheDir // Uses the default defined at top
        
        params.max_memory = '8.GB'
        params.max_cpus   = 4
    }

    // HPC / Slurm Profile
    slurm {
        process.executor     = 'slurm'
        process.queue        = 'batch' // change to your specific partition
        executor.queueSize   = 30
        executor.submitRateLimit = '3 sec'
        
        conda.enabled        = true
        params.condaCacheDir = "/spaces/stanford/anaconda3/envs"  // change path to your systems conda path 
        params.cacheDir = params.condaCacheDir
        params.PICARD = "${params.condaCacheDir}/fpgAlign/share/picard-2.27.4-0/picard.jar"

        params.FASTQC_CONF         = "${params.condaCacheDir}/fpgtrimReads/opt/fastqc-0.11.9/Configuration"
        params.FASTQC_CONTAMINANTS = "${params.FASTQC_CONF}/contaminant_list.txt"
        params.FASTQC_ADAPTERS     = "${params.FASTQC_CONF}/adapter_list.txt"

        params.max_memory = '128.GB'
        params.max_cpus = 32
    }
    
    // Docker Profile
    docker {
        docker.enabled = true
        conda.enabled  = false
    }
}

// =================================================================
// Process Resource Configuration
// =================================================================

process {
    // If a process has no label, it gets these small resources
    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 6.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 3

    // LABEL DEFINITIONS
    
    withLabel: process_low {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
    
    withLabel: process_medium {
        cpus   = { check_max( 6     * task.attempt, 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }
    
    withLabel: process_high {
        cpus   = { check_max( 12    * task.attempt, 'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }

    // Optional override for massive tasks
    withLabel: process_long {
        time   = { check_max( 48.h  * task.attempt, 'time'   ) }
    }
}



// =================================================================
// Functions
// =================================================================
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
